# Sanskruti Digital Cultural Archive Configuration Contract
# Copy this file to .env (or backend/.env) for local development

# Environment: 'development' or 'production'
ENVIRONMENT=development

# Database: SQLite by default for zero-friction local development, or PostgreSQL for production
# Local SQLite default:
DATABASE_URL=sqlite:///./sanskruti.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/sanskruti

# Curator & Administrative Security
# Required to access curator review queues, approve/reject community submissions, and perform privileged writes.
CURATOR_API_KEY=dev-curator-secret-key-change-in-prod

# CORS Allowed Origins (Comma-separated list or JSON array of origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost

# Media Storage Configuration
MEDIA_STORAGE_DIR=media_storage
MAX_UPLOAD_SIZE_BYTES=10485760

# Optional Google Gemini AI Configuration
# The digital archive operates completely autonomously with full reliability without any AI key.
# Live LLM inference will activate only if a valid key is provided.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
